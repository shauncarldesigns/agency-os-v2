{
  "name": "agency-os-v2-api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "test:messaging": "node --experimental-strip-types --test tests/messagingRules.test.ts && esbuild tests/messagingRouting.fixture.mjs --bundle --platform=node --format=esm --outfile=/tmp/agency-os-messaging-routing-fixture.mjs && node /tmp/agency-os-messaging-routing-fixture.mjs",
    "test:messaging:integration": "node scripts/test-messaging-integration.mjs",
    "db:migrate": "wrangler d1 execute agency-os-v2 --file=src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute agency-os-v2 --remote --file=src/db/schema.sql"
  },
  "dependencies": {
    "hono": "^4.12.33",
    "jose": "^6.2.7",
    "svix": "^1.99.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.120.0"
  }
}
