AGENCY_OS_API_URL=http://localhost:8788
BUILDER_API_TOKEN=replace-with-the-worker-secret
LANDINGSITE_URL=https://app.landingsite.ai
BUILDER_POLL_INTERVAL_MS=15000
# Successes store no media. Failures store a JSON log and screenshot.
# Enable only during targeted debugging; traces can be hundreds of MB.
BUILDER_TRACE_ON_FAILURE=false
BUILDER_ARTIFACT_RETENTION_DAYS=30
# Optional absolute paths. Defaults stay inside builder-worker/.
# BUILDER_PROFILE_DIR=/path/to/dedicated-builder-profile
# BUILDER_ARTIFACT_DIR=/path/to/builder-artifacts
